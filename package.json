{
  "name": "@shortdiv/parseltongue",
  "version": "0.1.0",
  "description": "Browser-safe TypeScript parsers that turn coding-agent sessions into text-free events",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/shortdiv/parseltongue.git" },
  "homepage": "https://github.com/shortdiv/parseltongue#readme",
  "bugs": "https://github.com/shortdiv/parseltongue/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "devEngines": { "runtime": { "name": "node", "version": ">=22" } },
  "publishConfig": { "access": "public" },
  "keywords": ["claude-code", "codex", "pi", "opencode", "cursor", "zed", "jsonl", "transcript", "session", "parser"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run check:package"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
